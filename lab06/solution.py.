def count_items(values):
    res = {}
    for v in values:
        if v in res:
            res[v] += 1
        else:
            res[v] = 1
    return res

def unique_sorted(values):
    return sorted(list(set(values)))

def common(first, second):
    res = []
    for x in first:
        if x in second and x not in res:
            res.append(x)
    return sorted(res)

def only_in_first(first, second):
    res = []
    for x in first:
        if x not in second and x not in res:
            res.append(x)
    return sorted(res)

